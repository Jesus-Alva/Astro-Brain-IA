# ============================================
#  ASTRO-IA - Variables de Entorno
#  Copia este archivo a .env y ajusta los valores:
#  cp .env.example .env
# ============================================

# --------------------------------------------
#  Backend
# --------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PYTHONUNBUFFERED=1

# --------------------------------------------
#  Frontend
# --------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
WATCHPACK_POLLING=true

# --------------------------------------------
#  Ollama
# --------------------------------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral
OLLAMA_KEEP_ALIVE=24h

# --------------------------------------------
#  Telegram (Opcional)
#  Obtén un token en: https://t.me/BotFather
# --------------------------------------------
TELEGRAM_TOKEN=

# --------------------------------------------
#  Twilio / WhatsApp (Opcional)
#  Obtén credenciales en: https://console.twilio.com
# --------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --------------------------------------------
#  Configuración de la IA
# --------------------------------------------
IA_NOMBRE=AstroIA
IA_MODELO=mistral
IA_TEMPERATURA=0.7
IA_PERSONALIDAD=amigable

# --------------------------------------------
#  Configuración de la memoria
# --------------------------------------------
MEMORIA_DIRECTORIO=conocimiento/
MEMORIA_SIMILARIDAD_MINIMA=0.7
MEMORIA_AUTO_APRENDER=true
MEMORIA_MIN_MENSAJES=3

# --------------------------------------------
#  Entorno
# --------------------------------------------
ENVIRONMENT=development