# ============================================
#  .gitignore para FRONTEND (Next.js)
# ============================================

# Dependencias
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/
/build
/vercel

# Producción
/dist

# Misceláneos
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables de entorno locales
.env*.local
.env

# Caché
/.cache
/.parcel-cache
.eslintcache
.turbo

# EXCEPCIONES (SÍ subir)
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!next.config.js
!tailwind.config.js
!postcss.config.js
